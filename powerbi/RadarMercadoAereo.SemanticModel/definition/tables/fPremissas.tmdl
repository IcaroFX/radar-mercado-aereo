	partition fPremissas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fPremissas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"Mercado2025", type number}, {"Mercado2026Est", type number}, {"GOL2025", type number}, {"Share12m", type number}, {"CrescBase2027", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

