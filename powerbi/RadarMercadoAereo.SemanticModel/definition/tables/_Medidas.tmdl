	measure 'MAPE do modelo escolhido' = CALCULATE ( MAX ( fBacktest[MAPE] ), fBacktest[Escolhido] = "Sim" )
		formatString: 0.0%
		displayFolder: 8. Forecast
		lineageTag: 34d72fce-2e02-4f31-9080-1d5b9a422868

	measure 'Mercado previsto 2027' = CALCULATE ( SUM ( fForecast[Previsao] ), FILTER ( ALL ( fForecast ), YEAR ( fForecast[Data] ) = 2027 ) )
		formatString: #,0
		displayFolder: 8. Forecast
		lineageTag: e4d547cc-fbb1-4343-bce6-1e032752c5de

	measure 'Premissa crescimento' = SELECTEDVALUE ( 'Cenário crescimento'[Crescimento 2027], MAX ( fPremissas[CrescBase2027] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 8. Forecast
		lineageTag: b32eb9d3-b3e3-45db-a72b-38c3f112ae6c

	measure 'Premissa share GOL' = SELECTEDVALUE ( 'Cenário share'[Share GOL 2027], MAX ( fPremissas[Share12m] ) )
		formatString: 0.0%
		displayFolder: 8. Forecast
		lineageTag: bd0d1da3-9fdb-403a-a504-5daf1530d8d2

	measure 'Mercado 2027 (cenário)' = MAX ( fPremissas[Mercado2026Est] ) * ( 1 + [Premissa crescimento] ) / 1000000
		formatString: 0.0" mi"
		displayFolder: 8. Forecast
		lineageTag: c5e421bf-797a-43aa-9929-000e8f7c81d2

	measure 'GOL 2027 (cenário)' = [Mercado 2027 (cenário)] * [Premissa share GOL]
		formatString: 0.0" mi"
		displayFolder: 8. Forecast
		lineageTag: b82b6fe0-896b-4f6b-8107-973dc6197314

	measure 'GOL 2027 vs 2025' = DIVIDE ( [GOL 2027 (cenário)] * 1000000, MAX ( fPremissas[GOL2025] ) ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 8. Forecast
		lineageTag: 3a1e2435-2b79-44c4-b1ad-9a46d5cee2d3

	measure 'GOL 2027 vs cenário base' =
			VAR base = MAX ( fPremissas[Mercado2026Est] ) * ( 1 + MAX ( fPremissas[CrescBase2027] ) ) * MAX ( fPremissas[Share12m] ) / 1000000
			RETURN [GOL 2027 (cenário)] - base
		formatString: +0.0" mi";-0.0" mi";0.0" mi"
		displayFolder: 8. Forecast
		lineageTag: 05d289a1-1db5-43f1-943d-fffd1eabbeed

	measure 'Insight Forecast' =
			"O modelo escolhido errou em média " & FORMAT ( [MAPE do modelo escolhido], "0.0%" )
			    & " no backtest (1 a 6 meses à frente). Para 2027, ele projeta " & FORMAT ( [Mercado previsto 2027] / 1000000, "0.0" )
			    & " milhões de passageiros no doméstico. Mexa nas premissas abaixo para ver o efeito na GOL."
		displayFolder: 7. Insights
		lineageTag: 0dcc9563-5424-4d2f-8763-120173c704ab

	measure 'Índice de passageiros' =
			VAR media =
			    DIVIDE (
			        CALCULATE ( [Passageiros], ALLSELECTED ( dCalendario ) ),
			        CALCULATE ( DISTINCTCOUNT ( fVoos[Data] ), ALLSELECTED ( dCalendario ) )
			    )
			RETURN DIVIDE ( [Passageiros], media ) * 100
		formatString: 0
		displayFolder: 8. Forecast
		lineageTag: cfd46524-ab9f-466c-b735-a244e0c06ce3

