table dCia
	lineageTag: b3699c35-ee63-402c-85f3-cee8eec82af1

	column Cia
		dataType: string
		lineageTag: 23695abb-d5c8-4961-ad84-cfdd42738aeb
		summarizeBy: none
		sourceColumn: Cia

		annotation SummarizationSetBy = Automatic

	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c6982695-44a2-4aab-8635-7a69a3392dd4
		summarizeBy: none
		sourceColumn: Ordem

		annotation SummarizationSetBy = Automatic

	column Cor
		dataType: string
