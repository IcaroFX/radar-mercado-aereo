	partition fVoos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fVoos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"Data", type date}, {"Cia", type text}, {"Empresa", type text}, {"Origem", type text}, {"Destino", type text}, {"Mercado", type text}, {"Passageiros", Int64.Type}, {"ASK", Int64.Type}, {"RPK", Int64.Type}, {"Assentos", Int64.Type}, {"Decolagens", Int64.Type}, {"DistanciaKm", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

