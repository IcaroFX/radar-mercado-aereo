		summarizeBy: none
		sourceColumn: Cor

		annotation SummarizationSetBy = Automatic

	partition dCia = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dCia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"Cia", type text}, {"Ordem", Int64.Type}, {"Cor", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

