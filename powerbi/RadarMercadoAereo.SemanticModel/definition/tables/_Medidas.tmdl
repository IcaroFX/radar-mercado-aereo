	measure 'Gap de Oferta GOL (pp)' = IF ( NOT ISBLANK ( [Passageiros GOL] ), ( [Share Assentos GOL] - [Share GOL] ) * 100 )
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 5. GOL
		lineageTag: ea9ac4ae-5431-4416-b9da-73b3e10e9a9c

