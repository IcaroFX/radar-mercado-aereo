	measure 'Share RPK 12m' =
			VAR fim = MAX ( dCalendario[Data] )
			VAR periodo = DATESINPERIOD ( dCalendario[Data], fim, -12, MONTH )
			RETURN
			    IF (
			        fim >= DATE ( 2019, 12, 1 ) && fim <= EOMONTH ( [Último mês com dados], 0 ),
			        DIVIDE ( CALCULATE ( [RPK], periodo ), CALCULATE ( [RPK], periodo, REMOVEFILTERS ( dCia ) ) )
			    )
		formatString: 0.0%
		displayFolder: 4. Share
		lineageTag: bc43a2e4-ff6f-4210-ad88-46d81ef45823

	measure 'Share Passageiros' = DIVIDE ( [Passageiros], CALCULATE ( [Passageiros], REMOVEFILTERS ( dCia ) ) )
		formatString: 0.0%
		displayFolder: 4. Share
		lineageTag: 7f893a91-fb72-47f9-a79c-db301475f28f

	measure 'Load Factor mensal' =
			VAR fim = MAX ( dCalendario[Data] )
			RETURN IF ( fim <= EOMONTH ( [Último mês com dados], 0 ), [Load Factor] )
		formatString: 0.0%
		displayFolder: 4. Share
		lineageTag: 8d40f07f-9e64-4ea2-baa1-443b3034703a

