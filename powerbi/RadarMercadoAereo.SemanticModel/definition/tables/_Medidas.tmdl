	measure 'LF GOL vs Mercado (pp)' = IF ( NOT ISBLANK ( [LF GOL] ), ( [LF GOL] - [LF Mercado] ) * 100 )
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 5. GOL
